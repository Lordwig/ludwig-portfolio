<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 750" width="1200" height="750">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a"/>
      <stop offset="100%" stop-color="#1e293b"/>
    </linearGradient>
    <linearGradient id="cardGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#1e293b"/>
      <stop offset="100%" stop-color="#0f172a"/>
    </linearGradient>
    <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#3b82f6"/>
      <stop offset="100%" stop-color="#60a5fa"/>
    </linearGradient>
  </defs>

  <!-- Background -->
  <rect width="1200" height="750" fill="url(#bgGrad)"/>

  <!-- Left Sidebar -->
  <rect x="0" y="0" width="240" height="750" fill="#0b1120" stroke="#1e293b" stroke-width="1"/>
  
  <!-- Logo -->
  <g transform="translate(24, 28)">
    <rect width="36" height="36" rx="8" fill="url(#accentGrad)"/>
    <path d="M10 26 L18 10 L26 26 M14 20 L22 20" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
    <text x="46" y="22" font-family="'Instrument Sans', system-ui, sans-serif" font-size="16" font-weight="700" fill="#ffffff">AutoAvenue</text>
    <text x="46" y="34" font-family="'Instrument Sans', system-ui, sans-serif" font-size="10" font-weight="600" fill="#3b82f6" letter-spacing="1.5">IMS SYSTEM</text>
  </g>

  <!-- Nav Items -->
  <g transform="translate(16, 95)" font-family="'Instrument Sans', system-ui, sans-serif" font-size="13" font-weight="600">
    <!-- Active Item: Dashboard -->
    <rect width="208" height="40" rx="8" fill="#1e293b"/>
    <circle cx="20" cy="20" r="4" fill="#3b82f6"/>
    <text x="36" y="25" fill="#ffffff">Dashboard Overview</text>

    <!-- Item: Inventory -->
    <g transform="translate(0, 48)">
      <text x="36" y="25" fill="#94a3b8">Parts Inventory</text>
      <circle cx="20" cy="20" r="3" fill="#475569"/>
    </g>

    <!-- Item: Purchase Orders -->
    <g transform="translate(0, 96)">
      <text x="36" y="25" fill="#94a3b8">Purchase Orders</text>
      <circle cx="20" cy="20" r="3" fill="#475569"/>
      <rect x="160" y="10" width="28" height="18" rx="9" fill="#3b82f6" fill-opacity="0.2"/>
      <text x="174" y="23" font-size="10" fill="#60a5fa" text-anchor="middle">12</text>
    </g>

    <!-- Item: Sales Tracking -->
    <g transform="translate(0, 144)">
      <text x="36" y="25" fill="#94a3b8">Sales &amp; Invoices</text>
      <circle cx="20" cy="20" r="3" fill="#475569"/>
    </g>

    <!-- Item: Suppliers -->
    <g transform="translate(0, 192)">
      <text x="36" y="25" fill="#94a3b8">Suppliers Directory</text>
      <circle cx="20" cy="20" r="3" fill="#475569"/>
    </g>

    <!-- Item: Reports -->
    <g transform="translate(0, 240)">
      <text x="36" y="25" fill="#94a3b8">Reports &amp; Analytics</text>
      <circle cx="20" cy="20" r="3" fill="#475569"/>
    </g>
  </g>

  <!-- Sidebar User Profile -->
  <g transform="translate(16, 680)">
    <rect width="208" height="52" rx="10" fill="#111827" stroke="#1e293b" stroke-width="1"/>
    <circle cx="28" cy="26" r="15" fill="#3b82f6"/>
    <text x="28" y="31" font-family="'Instrument Sans', sans-serif" font-size="12" font-weight="700" fill="#ffffff" text-anchor="middle">LO</text>
    <text x="52" y="22" font-family="'Instrument Sans', sans-serif" font-size="12" font-weight="600" fill="#f8fafc">Ludwig Olarte</text>
    <text x="52" y="36" font-family="'Instrument Sans', sans-serif" font-size="10" fill="#64748b">Admin · Stock Manager</text>
  </g>

  <!-- Top App Header -->
  <rect x="240" y="0" width="960" height="70" fill="#0f172a" stroke="#1e293b" stroke-width="1"/>
  
  <!-- Search Bar -->
  <g transform="translate(265, 16)">
    <rect width="400" height="38" rx="8" fill="#1e293b" stroke="#334155" stroke-width="1"/>
    <text x="38" y="24" font-family="'Instrument Sans', sans-serif" font-size="13" fill="#64748b">Search parts by SKU, OEM, car model, or name...</text>
    <circle cx="20" cy="19" r="6" fill="none" stroke="#64748b" stroke-width="1.8"/>
    <line x1="24" y1="23" x2="28" y2="27" stroke="#64748b" stroke-width="1.8" stroke-linecap="round"/>
  </g>

  <!-- Header Right Actions -->
  <g transform="translate(1030, 16)">
    <rect width="135" height="38" rx="8" fill="url(#accentGrad)"/>
    <text x="67" y="24" font-family="'Instrument Sans', sans-serif" font-size="13" font-weight="600" fill="#ffffff" text-anchor="middle">+ Add Part</text>
  </g>

  <!-- Main Content Area -->
  <g transform="translate(265, 92)">
    <!-- Page Title Row -->
    <text x="0" y="24" font-family="'Instrument Sans', system-ui, sans-serif" font-size="22" font-weight="700" fill="#ffffff">Parts Inventory Overview</text>
    <text x="0" y="44" font-family="'Instrument Sans', system-ui, sans-serif" font-size="13" fill="#94a3b8">Real-time stock catalog, purchase orders, and sales tracking</text>

    <!-- Stat Cards Row -->
    <g transform="translate(0, 60)">
      <!-- Stat 1: Total Stock -->
      <g transform="translate(0, 0)">
        <rect width="215" height="90" rx="12" fill="#1e293b" stroke="#334155" stroke-width="1"/>
        <text x="18" y="30" font-family="'Instrument Sans', sans-serif" font-size="12" font-weight="600" fill="#94a3b8">TOTAL PARTS IN STOCK</text>
        <text x="18" y="62" font-family="'Instrument Sans', sans-serif" font-size="26" font-weight="700" fill="#f8fafc">3,480</text>
        <text x="115" y="60" font-family="'Instrument Sans', sans-serif" font-size="11" font-weight="600" fill="#10b981">↑ +14% mo</text>
      </g>

      <!-- Stat 2: Low Stock Alert -->
      <g transform="translate(230, 0)">
        <rect width="215" height="90" rx="12" fill="#1e293b" stroke="#334155" stroke-width="1"/>
        <text x="18" y="30" font-family="'Instrument Sans', sans-serif" font-size="12" font-weight="600" fill="#94a3b8">LOW STOCK ALERTS</text>
        <text x="18" y="62" font-family="'Instrument Sans', sans-serif" font-size="26" font-weight="700" fill="#f59e0b">12 Items</text>
        <rect x="140" y="44" width="60" height="22" rx="11" fill="#f59e0b" fill-opacity="0.2"/>
        <text x="170" y="59" font-family="'Instrument Sans', sans-serif" font-size="10" font-weight="700" fill="#f59e0b" text-anchor="middle">Action</text>
      </g>

      <!-- Stat 3: Monthly Revenue -->
      <g transform="translate(460, 0)">
        <rect width="215" height="90" rx="12" fill="#1e293b" stroke="#334155" stroke-width="1"/>
        <text x="18" y="30" font-family="'Instrument Sans', sans-serif" font-size="12" font-weight="600" fill="#94a3b8">MONTHLY SALES</text>
        <text x="18" y="62" font-family="'Instrument Sans', sans-serif" font-size="26" font-weight="700" fill="#f8fafc">₱384,250</text>
        <text x="150" y="60" font-family="'Instrument Sans', sans-serif" font-size="11" font-weight="600" fill="#10b981">↑ +21%</text>
      </g>

      <!-- Stat 4: Purchase Orders -->
      <g transform="translate(690, 0)">
        <rect width="215" height="90" rx="12" fill="#1e293b" stroke="#334155" stroke-width="1"/>
        <text x="18" y="30" font-family="'Instrument Sans', sans-serif" font-size="12" font-weight="600" fill="#94a3b8">PENDING ORDERS</text>
        <text x="18" y="62" font-family="'Instrument Sans', sans-serif" font-size="26" font-weight="700" fill="#60a5fa">8 Active</text>
        <circle cx="178" cy="54" r="6" fill="#3b82f6"/>
      </g>
    </g>

    <!-- Table Section -->
    <g transform="translate(0, 175)">
      <rect width="905" height="380" rx="12" fill="#1e293b" stroke="#334155" stroke-width="1"/>
      
      <!-- Table Header -->
      <path d="M0 0 h905 v42 h-905 z" fill="#111827"/>
      <g transform="translate(20, 26)" font-family="'Instrument Sans', sans-serif" font-size="11" font-weight="700" fill="#64748b" letter-spacing="0.5">
        <text x="0" y="0">PART SKU</text>
        <text x="110" y="0">PART DESCRIPTION</text>
        <text x="340" y="0">COMPATIBLE VEHICLE</text>
        <text x="530" y="0">STOCK</text>
        <text x="640" y="0">STATUS</text>
        <text x="760" y="0">UNIT PRICE</text>
      </g>

      <!-- Row 1 -->
      <g transform="translate(20, 75)" font-family="'Instrument Sans', sans-serif" font-size="13">
        <text x="0" y="0" font-family="monospace" font-size="12" font-weight="600" fill="#3b82f6">BRK-7701</text>
        <text x="110" y="0" font-weight="600" fill="#f8fafc">Brembo Ceramic Front Brake Pads</text>
        <text x="340" y="0" fill="#94a3b8">Toyota Vios / Yaris (2018-2023)</text>
        <text x="530" y="0" font-weight="700" fill="#f8fafc">48 pcs</text>
        <rect x="635" y="-14" width="76" height="20" rx="10" fill="#10b981" fill-opacity="0.2"/>
        <text x="673" y="0" font-size="10.5" font-weight="700" fill="#10b981" text-anchor="middle">IN STOCK</text>
        <text x="760" y="0" font-weight="700" fill="#f8fafc">₱2,450.00</text>
      </g>
      <line x1="20" y1="102" x2="885" y2="102" stroke="#334155" stroke-width="1"/>

      <!-- Row 2 -->
      <g transform="translate(20, 135)" font-family="'Instrument Sans', sans-serif" font-size="13">
        <text x="0" y="0" font-family="monospace" font-size="12" font-weight="600" fill="#3b82f6">FLT-1042</text>
        <text x="110" y="0" font-weight="600" fill="#f8fafc">OEM Micro Oil Filter High Flow</text>
        <text x="340" y="0" fill="#94a3b8">Honda Civic FC / City (2016+)</text>
        <text x="530" y="0" font-weight="700" fill="#f59e0b">7 pcs</text>
        <rect x="635" y="-14" width="82" height="20" rx="10" fill="#f59e0b" fill-opacity="0.2"/>
        <text x="676" y="0" font-size="10.5" font-weight="700" fill="#f59e0b" text-anchor="middle">LOW STOCK</text>
        <text x="760" y="0" font-weight="700" fill="#f8fafc">₱420.00</text>
      </g>
      <line x1="20" y1="162" x2="885" y2="162" stroke="#334155" stroke-width="1"/>

      <!-- Row 3 -->
      <g transform="translate(20, 195)" font-family="'Instrument Sans', sans-serif" font-size="13">
        <text x="0" y="0" font-family="monospace" font-size="12" font-weight="600" fill="#3b82f6">SPK-9018</text>
        <text x="110" y="0" font-weight="600" fill="#f8fafc">NGK Laser Iridium Spark Plugs (4x)</text>
        <text x="340" y="0" fill="#94a3b8">Universal 4-Cylinder EFI</text>
        <text x="530" y="0" font-weight="700" fill="#f8fafc">64 sets</text>
        <rect x="635" y="-14" width="76" height="20" rx="10" fill="#10b981" fill-opacity="0.2"/>
        <text x="673" y="0" font-size="10.5" font-weight="700" fill="#10b981" text-anchor="middle">IN STOCK</text>
        <text x="760" y="0" font-weight="700" fill="#f8fafc">₱2,100.00</text>
      </g>
      <line x1="20" y1="222" x2="885" y2="222" stroke="#334155" stroke-width="1"/>

      <!-- Row 4 -->
      <g transform="translate(20, 255)" font-family="'Instrument Sans', sans-serif" font-size="13">
        <text x="0" y="0" font-family="monospace" font-size="12" font-weight="600" fill="#3b82f6">SHK-4420</text>
        <text x="110" y="0" font-weight="600" fill="#f8fafc">KYB Excel-G Gas Shock Absorber</text>
        <text x="340" y="0" fill="#94a3b8">Mitsubishi Mirage G4 / Hatch</text>
        <text x="530" y="0" font-weight="700" fill="#ef4444">3 pcs</text>
        <rect x="635" y="-14" width="74" height="20" rx="10" fill="#ef4444" fill-opacity="0.2"/>
        <text x="672" y="0" font-size="10.5" font-weight="700" fill="#ef4444" text-anchor="middle">REORDER</text>
        <text x="760" y="0" font-weight="700" fill="#f8fafc">₱3,850.00</text>
      </g>
      <line x1="20" y1="282" x2="885" y2="282" stroke="#334155" stroke-width="1"/>

      <!-- Row 5 -->
      <g transform="translate(20, 315)" font-family="'Instrument Sans', sans-serif" font-size="13">
        <text x="0" y="0" font-family="monospace" font-size="12" font-weight="600" fill="#3b82f6">BLT-3108</text>
        <text x="110" y="0" font-weight="600" fill="#f8fafc">Gates Heavy-Duty Serpentine Belt</text>
        <text x="340" y="0" fill="#94a3b8">Nissan Almera 1.5L (2014-2020)</text>
        <text x="530" y="0" font-weight="700" fill="#f8fafc">28 pcs</text>
        <rect x="635" y="-14" width="76" height="20" rx="10" fill="#10b981" fill-opacity="0.2"/>
        <text x="673" y="0" font-size="10.5" font-weight="700" fill="#10b981" text-anchor="middle">IN STOCK</text>
        <text x="760" y="0" font-weight="700" fill="#f8fafc">₱1,250.00</text>
      </g>
    </g>
  </g>
</svg>
